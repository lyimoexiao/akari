# ── Akari Configuration ──────────────────────────────────────────
# Environment variables override config.yaml.
# Viper maps "server.port"  ←  "SERVER_PORT"  (dot → underscore, uppercase).
#
# Priority (highest → lowest):
#   1. OS environment variables (exported)
#   2. .env file (this file, loaded into environment)
#   3. configs/config.yaml (or custom CONFIG_PATH)
#   4. Built-in defaults (see config.go)

# Server
# SERVER_PORT=8080
# SERVER_MODE=debug
# SERVER_SHUTDOWN_TIMEOUT=10

# Database
# DATABASE_TYPE=sqlite
# DATABASE_DSN=
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_USER=root
# DATABASE_PASSWORD=
# DATABASE_NAME=data/akari.db

# Cache — type: "memory" | "redis" | "file"
# CACHE_TYPE=memory
# CACHE_MEMORY_DEFAULT_TTL=5m
# CACHE_MEMORY_SIZE=1024
# CACHE_REDIS_ADDR=localhost:6379
# CACHE_REDIS_PASSWORD=
# CACHE_REDIS_DB=0
# CACHE_FILE_DIR=data/cache

# Logger
# LOGGER_LEVEL=info
# LOGGER_FORMAT=console
# LOGGER_OUTPUT_PATH=data/logs/app.log
# LOGGER_MAX_SIZE=100
# LOGGER_MAX_AGE=30
# LOGGER_MAX_BACKUPS=3
# LOGGER_COMPRESS=true
# LOGGER_LOCAL_TIME=true

# Captcha
# CAPTCHA_ENABLED=false
# CAPTCHA_TYPE=click
# CAPTCHA_CACHE_PREFIX=captcha:

# JWT
# JWT_SECRET=change-me-in-production
# JWT_ISSUER=akari
# JWT_EXPIRATION=24h

# Auth
# AUTH_REGISTRATION_ENABLED=true
# AUTH_EMAIL_VERIFICATION_ENABLED=false
# AUTH_VERIFY_EMAIL_TOKEN_TTL=2h

# SMTP (email sending)
# SMTP_HOST=localhost
# SMTP_PORT=25
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_SSL=false